    },
    "body": {
      "contentType": "html",
      "content": "<div><div>Sharing initial prices below.</div>\n\n<div><at id=\"0\">Ally</at>&nbsp;Please have Ivan update the price to the correct size and include back pillow.&nbsp;</div>\n\n<div>Please clarify back pillow attachment construction?</div>\n\n<div>&nbsp;</div>\n\n\n<div itemprop=\"copy-paste-block\">\n\n<div style=\"font-size:12pt\">We can load about 99 PCs into 40' HQ.</div>\n\n\n<div style=\"font-size:12pt\">&nbsp;</div>\n\n\n<div style=\"font-size:12pt\">Alu version:</div>\n\n\n<div style=\"font-size:12pt\">&nbsp;</div>\n\n\n<div style=\"font-size:12pt\">COM: $398</div>\n\n\n<div style=\"font-size:12pt\">Natte: $477</div>\n\n\n<div style=\"font-size:12pt\">Windsor: $512</div>\n\n\n<div style=\"font-size:12pt\">BWCH: $552</div>\n\n\n<div style=\"font-size:12pt\">&nbsp;</div>\n\n\n<div style=\"font-size:12pt\">Teak version:</div>\n\n\n<div style=\"font-size:12pt\">&nbsp;</div>\n\n\n<div style=\"font-size:12pt\">COM: $529</div>\n\n\n<div style=\"font-size:12pt\">Natte: $627</div>\n\n\n<div style=\"font-size:12pt\">Windsor: $660</div>\n\n\n<div style=\"font-size:12pt\">BWCH: $696.</div>\n</div>\n</div>"
    },
