    "body": {
      "contentType": "html",
      "content": "<div>\n<div itemprop=\"copy-paste-block\">&nbsp;\n\n<div style=\"font-size:small\"><span style=\"background-color:#fcd116\"><b>Wall Fountain Sizes:</b></span></div>\n\n\n<ul style=\"font-size:small\">\n\n\t\n<li>40\" X 22\" X 50\"\n\t</li><li>50\" X 22\" X 40\"\n\t</li><li>28\" X 22\" X 50\"\n\t</li><li>22\" X 18.5\" X 45.5\"\n\t</li><li>48\" X 24\" X 72\"\n</li></ul>\n\n\n<div>&nbsp;</div>\n\n<div>&nbsp;</div>\n\n<div>\n\n<div style=\"font-size:small\"><span style=\"background-color:#fcd116\"><b>Plinth Fountain Sizes:</b></span></div>\n\n\n<div style=\"font-size:small\">\n\n<ul>\n\n\t\n<li>24” SQ., 24” H\n\t</li><li>18”SQ., 35 1/2” H\n\t</li><li>32” SQ., 15 3/4” H\n\t</li><li>36\" SQ., 36\" H\n</li></ul>\n\n</div>\n</div>\n\n\n</div>\n</div><attachment id=\"49a7a14f-92d5-442c-9d8b-854f9e6a1331\"></attachment><attachment id=\"6bf5c8d4-df6f-480e-a2f8-9f84c0372249\"></attachment>"
