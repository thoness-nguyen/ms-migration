      "user": {
        "@odata.type": "#microsoft.graph.teamworkUserIdentity",
        "id": "baf3fcdb-8883-43a8-a38f-f6b011ef8607",
        "displayName": "Emily Choi",
        "userIdentityType": "aadUser",
        "tenantId": "d8ff7b02-502f-4629-9429-e4735e2ee1aa"
      }
    },
    "body": {
      "contentType": "html",
      "content": "<div><div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>Glass Sliding Door RFP<br>\n\nAny resources we have that could price up this request?</div>\n\n<div>\n<div>&nbsp;</div>\n\n<div>\n<div>Details attached and below:</div>\n\n<div>\n<div>&nbsp;</div>\n\n<div>\n<div>Quantity:&nbsp;&nbsp; &nbsp;100 Sets<br>\n\n1 fixed single glass pane measuring 8’ tall x 6’ wide, black aluminum frame.<br>\n\n1 sliding single glass pane measuring 8’ tall x 6’ wide, black aluminum frame.<br>\n\nMechanism: The sliding glass door slides in front of the fixed glass window (from the perspective of being inside of the room)</div>\n\n<div>\n<div>&nbsp;</div>\n\n<div>\n<div>Targets Include<br>\n\n-Best costing possible<br>\n\n-As thin of a frame and glass as possible, while still passing Title 24 Regulation</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div><attachment id=\"7798eb00-a556-4261-9438-9b96199dc2d0\"></attachment><attachment id=\"fa2df385-2fb1-4dcc-a9b9-ffc2abf293af\"></attachment><attachment id=\"1687b5bb-18a4-4843-aa60-b9fec2beac2f\"></attachment>"
    },
    "channelIdentity": {
      "teamId": "570cfa6a-8cc0-44b9-9059-e427f8c7afc2",
      "channelId": "19:e3505fbb064f48689021432d529da569@thread.tacv2"
    },
    "attachments": [
      {
        "id": "7798eb00-a556-4261-9438-9b96199dc2d0",
        "contentType": "reference",
        "contentUrl": "https://harbouroutdoorasialimited.sharepoint.com/sites/HarbourPD/Shared Documents/AOMEI/Screen Shot 2021-02-14 at 6.48.26 PM copy.pdf",
