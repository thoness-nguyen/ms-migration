        "userIdentityType": "aadUser",
        "tenantId": "d8ff7b02-502f-4629-9429-e4735e2ee1aa"
      }
    },
    "body": {
      "contentType": "html",
      "content": "<div><div>\n<div>\n<div>CONCEPT:</div>\n\n\n<div itemprop=\"copy-paste-block\">\n\n<div style=\"font-size:small\"><b><a href=\"https://www.lviv.be/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://www.lviv.be/\">https://www.lviv.be/</a></b></div>\n\n\n<div style=\"font-size:small\">&nbsp;</div>\n\n\n<div style=\"font-size:small\">SQUARE:&nbsp;<a href=\"https://www.lviv.be/brass-cube-planter\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://www.lviv.be/brass-cube-planter\">https://www.lviv.be/<wbr>brass-cube-planter</a></div>\n\n\n<div style=\"font-size:small\">ROUND:&nbsp;<a href=\"https://www.lviv.be/brass-round-planter\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://www.lviv.be/brass-round-planter\">https://www.lviv.be/<wbr>brass-round-planter</a></div>\n\n\n<div style=\"font-size:small\">&nbsp;</div>\n\n\n<div style=\"font-size:small\">We are interested in these sizes:</div>\n\n\n<div style=\"font-size:small\">27\"W, 14\"H ROUND<br>\n\n35\"W, 19\"H ROUND<br>\n\n43\"W, 22\"H ROUND</div>\n\n\n<div style=\"font-size:small\">27\"W, 20\"H SQUARE<br>\n\n35\"W, 24\"H SQUARE<br>\n\n43\"W, 28\"H SQUARE</div>\n</div>\n</div>\n</div>\n</div><attachment id=\"9a8d2d46-47f3-47ed-8f73-fb3842ad3848\"></attachment>"
    },
    "channelIdentity": {
      "teamId": "570cfa6a-8cc0-44b9-9059-e427f8c7afc2",
